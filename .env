# ---- LLM provider keys (LiteLLM reads these) ----
OPENAI_API_KEY=sk-...
XAI_API_KEY=xai-...
ANTHROPIC_API_KEY=sk-ant-...

# ---- Optional: override model names (LiteLLM "provider/model" format) ----
# OPENAI_MODEL=openai/gpt-4o
# XAI_MODEL=xai/grok-4
# ANTHROPIC_MODEL=anthropic/claude-sonnet-5-5

# ---- Guardrails (DeepEval judge model + pass threshold 0-1) ----
JUDGE_MODEL=openai/gpt-4o-mini
GUARDRAIL_THRESHOLD=0.7

# ---- LangSmith tracing ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=multi-llm-chatbot
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
